{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "hibernate",
    "action" : "~/.config/sway/scripts/hibernation",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "lock",
    "action" : "swaylock -f",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "swaylock -f && systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "logout",
    "action" : "pw-play /usr/share/sounds/freedesktop/stereo/service-logout.oga && swaymsg exit",
    "text" : "Logout",
    "keybind" : "e"
}
