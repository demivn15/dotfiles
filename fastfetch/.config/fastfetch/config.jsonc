{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
      "type": "file",
      "source": "$HOME/.config/fastfetch/logo.txt",
      "padding": { "top": 0, "bottom": 0, "left": 0, "right": 1 },
      "color": { "1": "magenta" }
  },
  "display": {
    "separator": " ",
    "color": {
        "keys": "red"
    },
    "key": {
        "type": "both"
    }
  },
  "modules": [
    "host",
    "kernel",
    "os",
    "uptime",
    "separator",
    "packages",
    "wm",
    "shell",
    "separator",
    {
        "type": "disk",
        "format": "{1} / {2} ({3})"
    },
    {
        "type": "cpu",
        "format": "{name}"
    },
    {
        "type": "gpu",
        "format": "{name}"
    },
    "memory",
    "swap",
    "break",
    "colors",
    "break"
  ]
}
