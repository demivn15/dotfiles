# Layout configuration
# Information in: 'man 5 sway'

xwayland force
floating_modifier Mod4 normal
floating_maximum_size 1280 x 720

default_border          pixel 1
default_floating_border pixel 1

gaps {
        inner 20
        outer 10
    }

client.focused   #2f2f2f #2f2f2f #e0e0e0 #2f2f2f #2f2f2f
client.unfocused #2f2f2f #2f2f2f #e0e0e0 #2f2f2f #2f2f2f

focus_follows_mouse always
mouse_warping container

for_window [window_type="dialog"]        floating enable
for_window [window_type="utility"]       floating enable
for_window [window_type="toolbar"]       floating enable
for_window [window_type="splash"]        floating enable
for_window [window_type="menu"]          floating enable
for_window [window_type="dropdown_menu"] floating enable
for_window [window_type="popup_menu"]    floating enable
for_window [window_type="tooltip"]       floating enable
for_window [window_type="notification"]  floating enable

for_window [app_id="com.mitchellh.ghostty"] opacity set 0.9

for_window [app_id="chrome-cinhimbnkkaeohfgghhklpknlkffjgod-Default"] floating enable, move position center
for_window [app_id="com.github.rafostar.Clapper"]                     floating enable, move position center
for_window [app_id="nemo"]                                            floating enable, move position center
for_window [app_id="org.prismlauncher.PrismLauncher"]                 floating enable, move position center
for_window [app_id="net.lutris.Lutris"]                               floating enable, move position center
for_window [app_id="wdisplays"]                                       floating enable, move position center

for_window [app_id="swayimg"]                   floating enable, resize set 800 600, move position center
for_window [app_id="om.rafaelmardojai.Blanket"] floating enable, resize set 800 600, move position center
for_window [app_id="org.gnome.FileRoller"]      floating enable, resize set 800 600, move position center
for_window [app_id="galculator"]                floating enable, resize set 480 640, move position center

for_window [class="upc.exe"] floating enable, move position center
for_window [class="steam"]   floating enable, move position center
for_window [class="epicgameslauncher.exe"]   floating enable, move position center
