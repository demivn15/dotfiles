# Key bindings configuration
# Information in: 'man 5 sway'

include $HOME/.config/sway/config.d/variables

set $terminalEmulator $TERM
set $applicationMenu  fuzzel
set $webBrowser       helium --ozone-platform=wayland --use-webgpu-adapter=opengles
set $fileManager      nemo

bindsym Mod4+t     exec $terminalEmulator
bindsym Mod4+Space exec $applicationMenu
bindsym Mod4+b     exec $webBrowser
bindsym Mod4+e     exec $fileManager

bindsym Mod4+q            kill
bindsym Mod4+Shift+Return reload
bindsym Mod4+Shift+Delete exec flock -n /tmp/wlogout.lock -c "/usr/bin/wlogout"

bindsym Mod4+Left        focus left
bindsym Mod4+Down        focus down
bindsym Mod4+Up          focus up
bindsym Mod4+Right       focus right
bindsym Mod4+Shift+Left  move left
bindsym Mod4+Shift+Down  move down
bindsym Mod4+Shift+Up    move up
bindsym Mod4+Shift+Right move right
bindsym Mod4+c           move position center

bindsym Mod4+1       workspace 1
bindsym Mod4+2       workspace 2
bindsym Mod4+Shift+1 move container to workspace 1
bindsym Mod4+Shift+2 move container to workspace 2
bindsym Mod4+w       workspace back_and_forth

bindsym F11    fullscreen
bindsym Mod4+f floating toggle

bindsym Mod4+Shift+minus move scratchpad
bindsym Mod4+minus       scratchpad show

bindsym --locked XF86AudioMute         exec $SCRIPTS_DIR/volume_mute_osd
bindsym --locked XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- & exec pw-play $SOUNDS_DIR/audio-volume-change.oga
bindsym --locked XF86AudioRaiseVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ & exec pw-play $SOUNDS_DIR/audio-volume-change.oga
bindsym --locked XF86AudioMicMute      exec $SCRIPTS_DIR/mic_mute_osd
bindsym --locked XF86MonBrightnessDown exec brightnessctl --min-value=1067 set 5%-
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set +5%  
bindsym          XF86RFKill            exec $SCRIPTS_DIR/airplane_osd
bindsym          XF86Calculator        exec galculator
bindsym          Mod4+Shift+s          exec flock -n /tmp/screenshot.lock -c "$SCRIPTS_DIR/screenshot"
bindsym          Mod4+i                exec flock -n /tmp/settings_menu.lock -c "$SCRIPTS_DIR/settings_menu/main_menu"
bindsym          Ctrl+Alt+Tab          exec $SCRIPTS_DIR/window_switcher
bindsym          Mod4+p                exec wdisplays
bindsym 	     Mod4+l		           exec swaylock -f

bindgesture --exact --input-device=1267:12728:ELAN06FA:00_04F3:31B8_Touchpad swipe:3:left  workspace back_and_forth
bindgesture --exact --input-device=1267:12728:ELAN06FA:00_04F3:31B8_Touchpad swipe:3:right workspace back_and_forth
bindgesture --exact --input-device=1267:12728:ELAN06FA:00_04F3:31B8_Touchpad swipe:3:up    exec fuzzel
bindgesture --exact --input-device=1267:12728:ELAN06FA:00_04F3:31B8_Touchpad swipe:3:down  exec flock -n /tmp/wlogout.lock -c "/usr/bin/wlogout"
