# Key bindings configuration
# Information in: 'man 5 sway'

set $terminalEmulator kitty
set $applicationMenu noctalia msg panel-toggle launcher
set $webBrowser helium
set $fileManager nautilus

bindsym Mod4+t exec $terminalEmulator
bindsym Mod4+Space exec $applicationMenu
bindsym Mod4+b exec $webBrowser
bindsym Mod4+e exec $fileManager
bindsym Mod4+n exec noctalia msg panel-toggle control-center
bindsym Mod4+v exec codium

bindsym Mod4+q kill
bindsym Mod4+Shift+Return reload
bindsym Mod4+Shift+Delete exec noctalia msg panel-toggle session

bindsym Alt+Left focus left
bindsym Alt+Down focus down
bindsym Alt+Up focus up
bindsym Alt+Right focus right
bindsym Alt+Shift+Left move left
bindsym Alt+Shift+Down move down
bindsym Alt+Shift+Up move up
bindsym Alt+Shift+Right move right
bindsym Mod4+c move position center

bindsym Mod4+1 workspace 1
bindsym Mod4+2 workspace 2
bindsym Mod4+Shift+1 move container to workspace 1
bindsym Mod4+Shift+2 move container to workspace 2

bindsym Mod4+W workspace next
# bindsym Mod4+Left workspace prev
# bindsym Mod4+Shift+Left move container to workspace prev
# bindsym Mod4+Shift+Right move container to workspace next

bindsym F11 fullscreen
bindsym Mod4+f floating toggle

bindsym Mod4+m move scratchpad
bindsym Mod4+Shift+m scratchpad show

bindsym --locked XF86AudioMute exec noctalia msg volume-mute
bindsym --locked XF86AudioLowerVolume exec noctalia msg volume-down
bindsym --locked XF86AudioRaiseVolume exec noctalia msg volume-up
bindsym --locked XF86AudioMicMute exec noctalia msg mic-mute
bindsym --locked XF86MonBrightnessDown exec noctalia msg brightness-down
bindsym --locked XF86MonBrightnessUp exec noctalia msg brightness-up

bindsym XF86Calculator exec gnome-calculator
bindsym Mod4+Shift+s exec noctalia msg screenshot-region
bindsym Mod4+i exec noctalia msg settings-open
bindsym Mod4+p exec wdisplays
bindsym Mod4+l exec noctalia msg session lock
# bindsym Ctrl+Alt+Tab exec noctalia msg window-switcher

