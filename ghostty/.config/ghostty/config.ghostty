font-family = Hack Nerd Font
font-size = 14
theme = Tinacious Design Dark
cursor-style = block
shell-integration-features = no-cursor
cursor-style-blink = false
cursor-text = cell-background
working-directory = home
window-padding-x = 10
window-padding-y = 10
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = false
window-decoration = client
window-theme = ghostty
focus-follows-mouse = true
bell-features = audio
bell-audio-path = /usr/share/sounds/freedesktop/stereo/bell.oga
# Exported from https://paletty.dev/p/7yC6wq5nt6g/carbonfox

palette = 0=#282828
palette = 1=#ee5396
palette = 2=#25be6a
palette = 3=#08bdba
palette = 4=#78a9ff
palette = 5=#be95ff
palette = 6=#33b1ff
palette = 7=#dfdfe0
palette = 8=#484848
palette = 9=#f16da6
palette = 10=#46c880
palette = 11=#2dc7c4
palette = 12=#8cb6ff
palette = 13=#c8a5ff
palette = 14=#52bdff
palette = 15=#e4e4e5
background = #161616
foreground = #f2f4f8
cursor-color = #f2f4f8
cursor-text = #161616
selection-background = #2a2a2a
selection-foreground = #f2f4f8
