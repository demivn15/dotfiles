input {
    keyboard {
        xkb {
            layout "latam"
        }
    }
    touchpad {
        tap
        drag true
        natural-scroll
        scroll-method "two-finger"
        click-method "button-areas"
    }
    mouse {
    }
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus mode="center-xy-always"
}
